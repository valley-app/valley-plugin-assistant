      "order": 30
    },
    "right_sidebar": {
      "order": 20
    }
  },
  "panelCommand": "open",
  "settingsView": "assistant.settings",
  "settingsSections": [
    {
      "id": "chat",
      "label": "Chat",
      "labelKey": "plugin.assistant.section.chat",
      "icon": "chat",
      "description": "Conversations, projects, attachments, models, and conversation preferences.",
      "storage": [
        ".valley/plugins/data/assistant/chats"
      ],
      "descriptionKey": "auto.d39f9be319d6"
    },
    {
      "id": "projects",
      "label": "Projects",
      "labelKey": "assistant.project.projects",
      "icon": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22black%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M20%2020H4a2%202%200%200%201-2-2V6a2%202%200%200%201%202-2h5l2%202h9a2%202%200%200%201%202%202v10a2%202%200%200%201-2%202Z%22%2F%3E%3C%2Fsvg%3E",
      "description": "Working folders and shared instructions for projects.",
      "descriptionKey": "assistant.settings.projectsDescription"
    },
    {
      "id": "telegram",
      "label": "Telegram",
      "labelKey": "plugin.assistant.section.telegram",
      "icon": "send",
      "description": "Talk to the assistant from outside the app over Telegram. Add one connection per bot; each carries its own token, allow-list, instructions, router and commands. The app must be open to handle messages.",
      "descriptionKey": "auto.5bf6d99b1939"
    },
    {
      "id": "whatsapp",
      "label": "WhatsApp",
      "labelKey": "plugin.assistant.section.whatsapp",
      "icon": "whatsapp",
      "description": "Talk to the assistant from outside the app over an official WhatsApp Business Platform / Cloud API number — no Twilio, no WhatsApp Web bridge, no managed tunnel. The app must be open to handle messages.",
      "descriptionKey": "auto.9719ca7e71e4"
    }
  ],
  "drivers": [
    "notes",
    "files",
    "policy"
  ],
  "provides": [
    {
      "id": "guard.runtime",
