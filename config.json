      "range": "^1.0.0",
      "optional": true
    }
  ],
  "guardPresets": {
    "schemaVersion": 1,
    "defaultPreset": "recommended",
    "presets": [
      {
        "id": "recommended",
        "label": "Recommended",
        "version": 1,
        "description": "Reads are free; file writes, deletes and command runs confirm. Secrets are always blocked.",
        "entries": {
          "tools": {
            "write_file": {
              "decision": "confirm",
              "allowPreApproval": false
            },
            "delete_file": {
              "decision": "confirm",
              "allowPreApproval": false
            },
            "write_note": {
              "decision": "confirm",
              "allowPreApproval": false
            },
            "delete_note": {
              "decision": "confirm",
              "allowPreApproval": false
            },
            "write_rule": {
              "decision": "confirm",
              "allowPreApproval": false
            },
            "set_setting": {
              "decision": "confirm",
              "allowPreApproval": false
            },
            "run_command": {
              "decision": "confirm",
              "allowPreApproval": false
            }
          }
        }
      },
      {
        "id": "read-only",
        "label": "Read-only",
        "version": 1,
        "description": "The assistant can read and answer, but never write or run commands.",
        "entries": {
          "tools": {
            "write_file": {
              "decision": "deny"
            },
            "delete_file": {
              "decision": "deny"
            },
            "write_note": {
              "decision": "deny"
            },
            "delete_note": {
              "decision": "deny"
            },
            "write_rule": {
              "decision": "deny"
            },
            "set_setting": {
              "decision": "deny"
            },
            "run_command": {
              "decision": "deny"
            }
          }
        }
      }
    ]
  },
  "settingsSchema": {
    "fields": [
      {
        "key": "attachmentFolder",
        "label": "Attachment folder",
        "labelKey": "auto.b31da2770f6e",
        "type": "text",
        "description": "Where files you attach in a chat are saved in the vault",
        "descriptionKey": "auto.c4eea020917e",
        "validate": "vault-folder",
        "section": "chat",
        "default": ""
      }
    ]
  },
