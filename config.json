  "runtime": {
    "ui": "runtime/index.js",
    "backend": "runtime/backend.js",
    "services": [
      {
        "id": "valley.text-embeddings",
        "version": "1.0.0",
        "method": "embeddings.compute",
        "request": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "texts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64
            }
          },
          "required": [
            "provider",
            "texts"
          ],
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "vectors": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "maxItems": 16384
              },
              "maxItems": 64
            }
          },
          "required": [
            "model",
            "vectors"
          ],
          "additionalProperties": false
        },
        "metadata": {
          "providers": [
            {
              "id": "openai",
              "label": "OpenAI",
              "defaultModel": "text-embedding-3-small",
              "labelKey": "connectionProviders.openai.name"
            },
            {
              "id": "ollama",
              "label": "Ollama",
              "defaultModel": "nomic-embed-text",
              "labelKey": "connectionProviders.ollama.name"
            }
          ]
        }
      },
      {
        "id": "valley.text-embeddings",
        "version": "2.0.0",
        "method": "embeddings.computeV2",
        "request": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "texts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64
            },
            "expectedIdentity": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "revision": {
                  "type": "union",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "source",
                "revision"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "provider",
            "texts"
          ],
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "vectors": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "maxItems": 16384
              },
              "maxItems": 64
            },
            "source": {
              "type": "string"
            },
            "revision": {
              "type": "union",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "model",
            "vectors",
            "source",
            "revision"
          ],
          "additionalProperties": false
        },
        "metadata": {
          "providers": [
            {
              "id": "openai",
              "label": "OpenAI",
              "defaultModel": "text-embedding-3-small",
              "labelKey": "connectionProviders.openai.name"
            },
            {
              "id": "ollama",
              "label": "Ollama",
              "defaultModel": "nomic-embed-text",
              "labelKey": "connectionProviders.ollama.name"
            }
          ],
          "identity": {
            "source": "connection-and-endpoint-sha256",
            "revision": "provider-reported-digest-or-null",
            "resolution": "explicit-semantic-operation"
          }
        }
      }
    ]
  },
