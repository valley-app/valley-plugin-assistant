+// Modified for Valley, 2026-09-27: shared model transport framing and cancellation checks.
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn forwards_model_stream_and_reports_dropped_requests() {
+    let mut outgoing = install().expect("install bridge once");
+    let mut response = stream(
+        "https://valley.invalid/responses",
+        json!({"model":"fixture"}),
+    )
+    .await
+    .expect("start stream");
+    let request: Value =
+        serde_json::from_str(&outgoing.recv().await.expect("request")).expect("valid JSON");
+    assert_eq!(request["method"], "valley/ai/request");
+    assert_eq!(request["params"]["body"]["model"], "fixture");
+    let id = request["params"]["id"].as_u64().expect("request id");
+    assert!(
+        receive(
+            &json!({"method":"valley/ai/chunk","params":{"id":id,"chunk":"data: Grüße\n\n"}})
+                .to_string()
+        )
+        .await
+    );
+    assert_eq!(
+        response
+            .bytes
+            .next()
+            .await
+            .expect("chunk")
+            .expect("success"),
+        Bytes::from("data: Grüße\n\n")
+    );
+    drop(response);
+    let cancelled: Value =
+        serde_json::from_str(&outgoing.recv().await.expect("cancel")).expect("valid JSON");
+    assert_eq!(cancelled["method"], "valley/ai/cancel");
+    assert_eq!(cancelled["params"]["id"], id);
+    assert!(!receive("{\"method\":\"turn/start\"}").await);
+}
