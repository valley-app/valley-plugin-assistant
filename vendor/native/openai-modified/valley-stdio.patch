+// Modified for Valley, 2026-09-27: route model requests over the owning App Server stdio connection.
+use crate::ByteStream;
+use crate::StreamResponse;
+use crate::TransportError;
+use bytes::Bytes;
+use futures::StreamExt;
+use http::HeaderMap;
+use http::StatusCode;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::HashMap;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use tokio::sync::mpsc;
+
+struct Bridge {
+    outgoing: mpsc::Sender<String>,
+    pending: Mutex<HashMap<u64, mpsc::Sender<Result<Option<Bytes>, String>>>>,
+    next_id: AtomicU64,
+}
+static BRIDGE: OnceLock<Bridge> = OnceLock::new();
+
+pub fn install() -> Option<mpsc::Receiver<String>> {
+    let (outgoing, incoming) = mpsc::channel(32);
+    BRIDGE
+        .set(Bridge {
+            outgoing,
+            pending: Mutex::new(HashMap::new()),
+            next_id: AtomicU64::new(1),
+        })
+        .ok()?;
+    Some(incoming)
+}
+
+pub async fn receive(line: &str) -> bool {
+    let Some(bridge) = BRIDGE.get() else {
+        return false;
+    };
+    let Ok(value) = serde_json::from_str::<Value>(line) else {
+        return false;
+    };
+    if value.get("method").and_then(Value::as_str) != Some("valley/ai/chunk") {
+        return false;
+    }
+    let Some(id) = value["params"]["id"].as_u64() else {
+        return true;
+    };
+    let sender = bridge
+        .pending
+        .lock()
+        .ok()
+        .and_then(|pending| pending.get(&id).cloned());
+    if let Some(sender) = sender {
+        let item = if let Some(error) = value["params"]["error"].as_str() {
+            Err(error.chars().take(4096).collect())
+        } else if value["params"]["done"].as_bool() == Some(true) {
+            Ok(None)
+        } else if let Some(chunk) = value["params"]["chunk"]
+            .as_str()
+            .filter(|chunk| chunk.len() <= 1024 * 1024)
+        {
+            Ok(Some(Bytes::copy_from_slice(chunk.as_bytes())))
+        } else {
+            Err("Invalid Valley transport chunk".to_string())
+        };
+        let _ = sender.send(item).await;
+    }
+    true
+}
+
+struct Lease(u64);
+impl Drop for Lease {
+    fn drop(&mut self) {
+        if let Some(bridge) = BRIDGE.get() {
+            if let Ok(mut pending) = bridge.pending.lock() {
+                pending.remove(&self.0);
+            }
+            let _ = bridge.outgoing.try_send(
+                json!({"jsonrpc":"2.0","method":"valley/ai/cancel","params":{"id":self.0}})
+                    .to_string(),
+            );
+        }
+    }
+}
+
+pub async fn stream(url: &str, body: Value) -> Result<StreamResponse, TransportError> {
+    let bridge = BRIDGE.get().ok_or_else(|| {
+        TransportError::Build("Valley shared transport is unavailable".to_string())
+    })?;
+    let id = bridge.next_id.fetch_add(1, Ordering::Relaxed);
+    let (sender, incoming) = mpsc::channel(16);
+    {
+        let mut pending = bridge
+            .pending
+            .lock()
+            .map_err(|_| TransportError::Build("Valley transport is unavailable".to_string()))?;
+        if pending.len() >= 16 {
+            return Err(TransportError::Build(
+                "Valley transport request limit reached".to_string(),
+            ));
+        }
+        pending.insert(id, sender);
+    }
+    let lease = Lease(id);
+    bridge.outgoing.send(json!({"jsonrpc":"2.0","method":"valley/ai/request","params":{"id":id,"url":url,"body":body}}).to_string()).await.map_err(|_| TransportError::Network("Valley transport closed".to_string()))?;
+    let bytes: ByteStream =
+        futures::stream::try_unfold((incoming, lease), |(mut incoming, lease)| async move {
+            match tokio::time::timeout(Duration::from_secs(900), incoming.recv()).await {
+                Ok(Some(Ok(Some(bytes)))) => Ok(Some((bytes, (incoming, lease)))),
+                Ok(Some(Ok(None))) => Ok(None),
+                Ok(Some(Err(error))) => Err(TransportError::Network(error)),
+                Ok(None) => Err(TransportError::Network(
+                    "Valley transport closed".to_string(),
+                )),
+                Err(_) => Err(TransportError::Timeout),
+            }
+        })
+        .boxed();
+    Ok(StreamResponse {
+        status: StatusCode::OK,
+        headers: HeaderMap::new(),
+        bytes,
+    })
+}
